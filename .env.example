# Next Plane — variáveis de ambiente
# Copie para ".env" (ou rode `npm run gerar-env`, que já cria o .env com segredos aleatórios).
# O arquivo .env NUNCA vai para o Git: ele guarda as senhas do servidor.

# ─── Banco de dados (PostgreSQL) ─────────────────────────────
POSTGRES_DB=nextplane
# Usuário DONO do banco: cria/altera tabelas. Só o `npm run migrate` usa.
POSTGRES_USER=nextplane_owner
POSTGRES_PASSWORD=
# Usuário da APLICAÇÃO: só lê e grava dados (não apaga nem altera tabelas). É criado pelo migrate.
APP_DB_USER=nextplane_app
APP_DB_PASSWORD=
# Onde o banco está. No docker-compose isso é ajustado sozinho para "db".
DB_HOST=localhost
DB_PORT=5432
# Alternativa: uma URL completa (substitui as variáveis acima)
# DATABASE_URL=postgres://usuario:senha@host:5432/nextplane
# DATABASE_ADMIN_URL=postgres://dono:senha@host:5432/nextplane
# DB_SSL=true            # para bancos gerenciados que exigem SSL

# ─── Segurança ───────────────────────────────────────────────
# Chave que ASSINA os JWTs de login (mín. 32 caracteres). Quem tiver esta chave consegue forjar sessões.
JWT_SECRET=
# Chave AES-256 (32 bytes em base64) que criptografa os dados dos clientes no banco.
# Se perder esta chave, os dados criptografados não abrem mais. Faça cópia num lugar seguro.
# Ao importar dados do Supabase, use a MESMA chave que está na Vercel.
CRM_ENCRYPTION_KEY=

# ─── Primeiro administrador (criado pelo migrate se ainda não existir nenhum) ──
ADMIN_EMAIL=
ADMIN_NOME=Joseph
# Senha inicial: o administrador é obrigado a trocá-la no primeiro acesso. Apague esta linha depois.
ADMIN_SENHA_INICIAL=

# ─── Site ────────────────────────────────────────────────────
PORT=3000
# Domínio público (o Caddy do docker-compose emite o HTTPS sozinho). Para testar no PC: localhost
DOMINIO=localhost
# https://seu-dominio.com.br
PUBLIC_URL=
# Quantos proxies existem na frente do app (Caddy do compose = 1; acesso direto, sem proxy = 0)
TRUST_PROXY=1
# Cookie de sessão só por HTTPS. Use false apenas para testar em http puro.
COOKIE_SECURE=true

# ─── Integração Meta Lead Ads (opcional; as mesmas da Vercel) ──
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=

# ─── Só para importar os dados antigos do Supabase (npm run importar-supabase) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
